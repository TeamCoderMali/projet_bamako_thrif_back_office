{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "admin-dashboard",
  "compatibility_date": "2026-07-25",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist/admin-dashboard/browser",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}